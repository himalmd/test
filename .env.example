# Snaply Environment Configuration
# Copy this file to .env and adjust values for your environment

# Database Configuration
DB_HOST=localhost
DB_NAME=snaply
DB_USER=root
DB_PASS=

# Media Storage Configuration
MEDIA_STORAGE_TYPE=local
MEDIA_BASE_PATH=/var/www/snaply/uploads/media
MEDIA_BASE_URL=/uploads/media
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_PLACEHOLDER_URL=/assets/images/placeholder.png
